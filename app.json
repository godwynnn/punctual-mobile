{
  "expo": {
    "name": "punctuahr",
    "slug": "punctua-hr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2c1039"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.godwynn.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.godwynn.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PunctualHr to access your location to verify clock-in/out coordinates."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PunctualHr to use the camera to scan QR codes for attendance verification."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d682953a-5e81-4e4c-94a9-41995698e013"
      }
    }
  }
}